# AdminOffboard Environment Configuration

# Application
APP_NAME=AdminOffboard
APP_ENV=production
APP_VERSION=0.1.0
APP_DEBUG=false

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nextcloud
DB_USER=nextcloud
DB_PASSWORD=secret

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Nextcloud
NEXTCLOUD_URL=https://your-nextcloud-domain.com
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=secret

# Admin Offboard Settings
QUEUE_BATCH_SIZE=100
QUEUE_MAX_ATTEMPTS=3
AUDIT_LOG_RETENTION_DAYS=90
REMOTE_WIPE_TIMEOUT=30
MAX_USERS_PER_OPERATION=1000
ALLOW_API_ACCESS=true
LOG_LEVEL=info

# Feature Flags
FEATURE_REMOTE_WIPE=true
FEATURE_BATCH_OPERATIONS=true
FEATURE_AUDIT_LOGGING=true
FEATURE_API_ACCESS=true
FEATURE_DRY_RUN=true
FEATURE_QUEUE_SYSTEM=true
FEATURE_AUTO_CLEANUP=true