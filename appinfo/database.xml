<?xml version="1.0" encoding="UTF-8" ?>
<database>
    <name>adminoffboard</name>
    <create>true</create>
    <overwrite>false</overwrite>
    <charset>utf8mb4</charset>
    
    <table>
        <name>adminoffboard_jobs</name>
        <comment>Table for queued offboard jobs</comment>
        <declaration>
            <field>
                <name>id</name>
                <type>integer</type>
                <default>0</default>
                <notnull>true</notnull>
                <autoincrement>1</autoincrement>
                <length>20</length>
            </field>
            <field>
                <name>job_type</name>
                <type>text</type>
                <length>64</length>
                <notnull>true</notnull>
            </field>
            <field>
                <name>status</name>
                <type>text</type>
                <length>32</length>
                <notnull>true</notnull>
                <default>pending</default>
            </field>
            <field>
                <name>payload</name>
                <type>clob</type>
                <notnull>true</notnull>
            </field>
            <field>
                <name>user_id</name>
                <type>text</type>
                <length>64</length>
                <notnull>false</notnull>
            </field>
            <field>
                <name>created_by</name>
                <type>text</type>
                <length>64</length>
                <notnull>false</notnull>
            </field>
            <field>
                <name>created_at</name>
                <type>integer</type>
                <notnull>true</notnull>
            </field>
            <field>
                <name>started_at</name>
                <type>integer</type>
                <notnull>false</notnull>
            </field>
            <field>
                <name>completed_at</name>
                <type>integer</type>
                <notnull>false</notnull>
            </field>
            <field>
                <name>attempts</name>
                <type>integer</type>
                <default>0</default>
                <notnull>true</notnull>
            </field>
            <field>
                <name>max_attempts</name>
                <type>integer</type>
                <default>3</default>
                <notnull>true</notnull>
            </field>
            <field>
                <name>error_message</name>
                <type>clob</type>
                <notnull>false</notnull>
            </field>
            <field>
                <name>priority</name>
                <type>integer</type>
                <default>5</default>
                <notnull>true</notnull>
            </field>
            <index>
                <name>job_status_idx</name>
                <field>
                    <name>status</name>
                </field>
            </index>
            <index>
                <name>job_created_idx</name>
                <field>
                    <name>created_at</name>
                </field>
            </index>
            <index>
                <name>job_user_idx</name>
                <field>
                    <name>user_id</name>
                </field>
            </index>
        </declaration>
    </table>
    
    <table>
        <name>adminoffboard_audit</name>
        <comment>Audit trail for all operations</comment>
        <declaration>
            <field>
                <name>id</name>
                <type>integer</type>
                <default>0</default>
                <notnull>true</notnull>
                <autoincrement>1</autoincrement>
                <length>20</length>
            </field>
            <field>
                <name>action</name>
                <type>text</type>
                <length>64</length>
                <notnull>true</notnull>
            </field>
            <field>
                <name>user_id</name>
                <type>text</type>
                <length>64</length>
                <notnull>true</notnull>
            </field>
            <field>
                <name>actor</name>
                <type>text</type>
                <length>64</length>
                <notnull>true</notnull>
            </field>
            <field>
                <name>target</name>
                <type>text</type>
                <length>255</length>
                <notnull>false</notnull>
            </field>
            <field>
                <name>details</name>
                <type>clob</type>
                <notnull>false</notnull>
            </field>
            <field>
                <name>status</name>
                <type>text</type>
                <length>32</length>
                <notnull>true</notnull>
            </field>
            <field>
                <name>ip_address</name>
                <type>text</type>
                <length>45</length>
                <notnull>false</notnull>
            </field>
            <field>
                <name>user_agent</name>
                <type>text</type>
                <length>255</length>
                <notnull>false</notnull>
            </field>
            <field>
                <name>timestamp</name>
                <type>integer</type>
                <notnull>true</notnull>
            </field>
            <index>
                <name>audit_action_idx</name>
                <field>
                    <name>action</name>
                </field>
            </index>
            <index>
                <name>audit_user_idx</name>
                <field>
                    <name>user_id</name>
                </field>
            </index>
            <index>
                <name>audit_actor_idx</name>
                <field>
                    <name>actor</name>
                </field>
            </index>
            <index>
                <name>audit_timestamp_idx</name>
                <field>
                    <name>timestamp</name>
                </field>
            </index>
        </declaration>
    </table>
    
    <table>
        <name>adminoffboard_devices</name>
        <comment>Device information cache</comment>
        <declaration>
            <field>
                <name>id</name>
                <type>integer</type>
                <default>0</default>
                <notnull>true</notnull>
                <autoincrement>1</autoincrement>
                <length>20</length>
            </field>
            <field>
                <name>user_id</name>
                <type>text</type>
                <length>64</length>
                <notnull>true</notnull>
            </field>
            <field>
                <name>token_id</name>
                <type>integer</type>
                <notnull>true</notnull>
            </field>
            <field>
                <name>device_type</name>
                <type>text</type>
                <length>64</length>
                <notnull>false</notnull>
            </field>
            <field>
                <name>device_name</name>
                <type>text</type>
                <length>255</length>
                <notnull>false</notnull>
            </field>
            <field>
                <name>last_activity</name>
                <type>integer</type>
                <notnull>false</notnull>
            </field>
            <field>
                <name>wipe_supported</name>
                <type>boolean</type>
                <default>0</default>
                <notnull>true</notnull>
            </field>
            <field>
                <name>created_at</name>
                <type>integer</type>
                <notnull>true</notnull>
            </field>
            <field>
                <name>updated_at</name>
                <type>integer</type>
                <notnull>true</notnull>
            </field>
            <index>
                <name>device_user_idx</name>
                <field>
                    <name>user_id</name>
                </field>
            </index>
            <index>
                <name>device_token_idx</name>
                <field>
                    <name>token_id</name>
                </field>
            </index>
            <unique>
                <name>device_unique_idx</name>
                <field>
                    <name>user_id</name>
                </field>
                <field>
                    <name>token_id</name>
                </field>
            </unique>
        </declaration>
    </table>
</database>