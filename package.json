{
  "name": "adminoffboard",
  "version": "0.1.0",
  "private": true,
  "description": "Admin Offboard - Advanced administration tool for Nextcloud",
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "postcss css/*.css -d dist/css",
    "build:js": "webpack --mode production",
    "watch": "webpack --watch",
    "test": "jest",
    "lint": "eslint js/**/*.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "vue": "^2.7.14",
    "vue-router": "^3.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.8.1",
    "eslint": "^8.51.0",
    "jest": "^29.7.0",
    "postcss": "^8.4.31",
    "postcss-cli": "^10.1.0",
    "style-loader": "^3.3.3",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  }
}